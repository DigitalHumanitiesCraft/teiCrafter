{
  "name": "teicrafter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "browserslist": [
    "baseline widely available"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "check:biome": "biome check --files-ignore-unknown=true docs/js test/e2e test/verify.mjs test/evaluate-editorial.mjs test/evaluation-results.mjs test/evaluation-inputs.mjs vite.config.js playwright.config.js",
    "verify": "node test/verify.mjs",
    "test:szd-mapping": "node --test test/szd-mapping-export.test.mjs test/szd-mapping-state.test.mjs",
    "verify:full-corpus": "npm run verify && node test/run_all.mjs szd_loadability_sweep && node test/run_all.mjs port_parity",
    "test:e2e": "playwright test",
    "evaluate:editorial": "node test/evaluate-editorial.mjs",
    "dev:prototypes": "vite --config prototypes/vite.config.js",
    "typecheck:src": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/xml": "^1.0.6"
  }
}
